#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Enable with: make hooks
set -euo pipefail
root="$(git rev-parse --show-toplevel)"

"$root/scripts/check-private.sh"

if command -v gitleaks >/dev/null 2>&1; then
	gitleaks git --staged --redact --no-banner "$root"
else
	echo "pre-commit: gitleaks not installed; skipping secret scan (CI still runs it)." >&2
fi
