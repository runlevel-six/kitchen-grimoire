package web

import (
	"strconv"
	"strings"

	"github.com/runlevel-six/kitchen-grimoire/internal/ingredient"
)

templ recipePage(r *recipeT, factor float64, isFav bool, f flash) {
	@recipeFrame(r.Title, r.Slug, f) {
		<article class="recipe">
			if r.Deleted() {
				<div class="banner banner-warn" role="status">
					<span>This recipe is in the trash. It will be removed permanently after { strconv.Itoa(trashDays(ctx)) } days.</span>
					<form method="post" action={ templ.URL("/r/" + r.Slug + "/undelete") } class="inline">
						<button class="btn btn-small" type="submit">Restore</button>
					</form>
				</div>
			}
			if r.NeedsReview {
				<div class="banner" role="note">
					<span>Flagged for review: { strings.Join(r.ReviewReasons, ", ") }</span>
				</div>
			}
			if im := r.PrimaryImage(); im != nil {
				<img
					class="hero"
					src={ imgURL(im) }
					srcset={ imgSrcset(im) }
					sizes="(min-width: 900px) 900px, 100vw"
					width={ strconv.Itoa(im.Width) }
					height={ strconv.Itoa(im.Height) }
					alt={ r.Title }
				/>
			}
			<header class="recipe-head">
				<h1>{ r.Title }</h1>
				<p id="offline-badge" class="badge" hidden>Available offline</p>
				if prov := provenance(r); prov != "" {
					<p class="provenance">{ prov }</p>
				}
				if r.Description != "" {
					<p class="lede">{ r.Description }</p>
				}
				<dl class="facts">
					if r.PrepMin > 0 {
						<div><dt>Prep</dt><dd>{ minutes(r.PrepMin) }</dd></div>
					}
					if r.CookMin > 0 {
						<div><dt>Cook</dt><dd>{ minutes(r.CookMin) }</dd></div>
					}
					if r.TotalMin > 0 {
						<div><dt>Total</dt><dd>{ minutes(r.TotalMin) }</dd></div>
					}
				</dl>
				if !r.Deleted() {
					<div class="actions">
						if r.StepCount() > 0 {
							<a class="btn btn-primary" href={ templ.URL("/r/" + r.Slug + "/cook") }>Start cooking</a>
						}
						<a class="btn" href={ templ.URL("/r/" + r.Slug + "/edit") }>Edit</a>
						@favoriteButton(r.Slug, isFav)
					</div>
				}
			</header>
			<div class="recipe-body">
				@ingredientsPanel(r, factor)
				<section class="steps-panel" aria-labelledby="steps-h">
					<h2 id="steps-h">Steps</h2>
					if r.StepCount() == 0 {
						<p class="muted">No steps written down.</p>
					}
					for gi, g := range r.StepGroups {
						if g.Name != "" {
							<h3>{ g.Name }</h3>
						}
						// Numbering continues across groups so it matches cook mode.
						<ol class="steps" start={ strconv.Itoa(firstStep(r, gi)) }>
							for _, s := range g.Steps {
								<li class="pre-line">{ s }</li>
							}
						</ol>
					}
					if r.Notes != "" {
						<h2>Notes</h2>
						<p class="notes">{ r.Notes }</p>
					}
					if r.OriginalText != "" {
						<details class="original">
							<summary>View original</summary>
							<pre>{ r.OriginalText }</pre>
						</details>
					}
					@recipeMeta(r)
				</section>
			</div>
			<footer class="recipe-foot">
				<a href={ templ.URL("/r/" + r.Slug + "/history") }>History ({ plural(r.Revision, "revision", "revisions") })</a>
				if !r.Deleted() {
					<form method="post" action={ templ.URL("/r/" + r.Slug + "/delete") } class="inline">
						<button class="btn-link danger" type="submit">Move to trash</button>
					</form>
				}
			</footer>
		</article>
	}
}

templ recipeMeta(r *recipeT) {
	if len(r.Categories) > 0 || len(r.Tags) > 0 || r.SourceURL != "" {
		<div class="meta">
			if len(r.Categories) > 0 {
				<p class="tags">
					for _, c := range r.Categories {
						<a class="tag" href={ templ.URL("/browse/category/" + categoryPathURL(c)) }>{ strings.Join(c, " › ") }</a>
					}
				</p>
			}
			if len(r.Tags) > 0 {
				<p class="tags">
					for _, t := range r.Tags {
						<a class="tag tag-soft" href={ templ.URL("/search?tag=" + slugify(t)) }>#{ t }</a>
					}
				</p>
			}
			if r.SourceURL != "" && safeHTTPURL(r.SourceURL) {
				<p class="muted">Source: <a href={ templ.SafeURL(r.SourceURL) } rel="noopener noreferrer nofollow">{ hostOf(r.SourceURL) }</a></p>
			}
		</div>
	}
}

// ingredientsPanel is also the htmx swap target for the scaler. Without
// JavaScript the scaler is a plain GET form that reloads the page.
templ ingredientsPanel(r *recipeT, factor float64) {
	<section id="ingredients" class="ingredients-panel" aria-labelledby="ing-h">
		<div class="panel-head">
			<h2 id="ing-h">Ingredients</h2>
			<p class="yield">{ yieldText(r, factor) }</p>
		</div>
		<button type="button" class="btn-link js-clear-checks" hidden>Clear checks</button>
		if r.IngredientCount() > 0 {
			<form
				class="scaler"
				method="get"
				action={ templ.URL("/r/" + r.Slug) }
				hx-get={ "/r/" + r.Slug }
				hx-select="#ingredients"
				hx-target="#ingredients"
				hx-swap="outerHTML"
				hx-push-url="true"
			>
				<span class="scaler-label" id="scale-l">Scale</span>
				<div class="chips" role="group" aria-labelledby="scale-l">
					for _, f := range scaleChoices {
						<button
							type="submit"
							name="x"
							value={ fmtFactor(f) }
							class={ "chip", templ.KV("chip-on", f == factor) }
							if f == factor {
								aria-pressed="true"
							} else {
								aria-pressed="false"
							}
						>{ fmtFactor(f) }×</button>
					}
				</div>
			</form>
		} else {
			<p class="muted">No ingredients written down.</p>
		}
		for gi, g := range r.IngredientGroups {
			if g.Name != "" {
				<h3>{ g.Name }</h3>
			}
			<ul class="ingredients">
				for ii, in := range g.Ingredients {
					{{ line, scaled := ingredient.Scaled(in, factor) }}
					<li>
						<label class="check">
							<input type="checkbox" name={ "i" + strconv.Itoa(gi) + "-" + strconv.Itoa(ii) }/>
							<span>
								{ line }
								if factor != 1 && !scaled {
									<span class="badge" title="This line wasn't understood, so it shows the original amount">not scaled</span>
								}
							</span>
						</label>
					</li>
				}
			</ul>
		}
	</section>
}

func provenance(r *recipeT) string {
	var parts []string
	if r.ContributedBy != "" {
		parts = append(parts, "From "+r.ContributedBy)
	}
	if r.Collection != "" {
		parts = append(parts, r.Collection)
	}
	if r.Author != "" {
		parts = append(parts, "By "+r.Author)
	}
	if r.SourceURL != "" && r.Author == "" {
		parts = append(parts, hostOf(r.SourceURL))
	}
	return strings.Join(parts, " · ")
}

templ favoriteButton(slug string, on bool) {
	<form
		id="fav"
		class="inline"
		method="post"
		action={ templ.URL("/r/" + slug + "/favorite") }
		hx-post={ "/r/" + slug + "/favorite" }
		hx-target="this"
		hx-swap="outerHTML"
	>
		if on {
			<input type="hidden" name="on" value="0"/>
			<button class="btn fav fav-on" type="submit" aria-pressed="true" title="Remove from favorites">★ Favorite</button>
		} else {
			<input type="hidden" name="on" value="1"/>
			<button class="btn fav" type="submit" aria-pressed="false" title="Add to favorites">☆ Favorite</button>
		}
	</form>
}
